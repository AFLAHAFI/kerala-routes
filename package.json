{
  "name": "kerala-routes",
  "version": "2.0.0-rc.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/local.mjs",
    "build": "tsc --noEmit && vite build --config client/vite.config.ts && npm run build:server",
    "start": "node dist-server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:client": "tsc --noEmit && vite build --config client/vite.config.ts",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "preview": "vite preview --config client/vite.config.ts --host 0.0.0.0",
    "local": "node scripts/local.mjs",
    "local:built": "node scripts/local.mjs --built",
    "test:resources": "node --import tsx tests/render-resources.test.ts"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "express": "^5.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

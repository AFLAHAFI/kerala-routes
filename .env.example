# Set server variables in Render's Environment screen.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PROFILE_TOKEN=YOUR_SERVER_ONLY_PROFILE_TOKEN
# Alternate direct REST adapter: use SUPABASE_SECRET_KEY instead of the profile token.
CLIENT_ORIGINS=https://YOUR_USERNAME.github.io
REQUIRE_PERSISTENCE=true
# Set this public variable under GitHub repository Actions variables:
VITE_SERVER_URL=https://YOUR_SERVICE.onrender.com
# Optional local .env loading: node --env-file=.env --import tsx server/src/index.ts
